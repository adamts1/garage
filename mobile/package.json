{
  "name": "garage-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@garage/shared": "file:../packages/shared",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.3",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.3",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:sim:ios": "eas build --platform ios --profile simulator",
    "run:sim:ios": "eas build:run --platform ios --profile simulator",
    "build:sim:android": "eas build --platform android --profile simulator",
    "run:sim:android": "eas build:run --platform android --profile simulator",
    "testflight:staging": "bash scripts/release.sh ios --profile staging --submit",
    "build:staging:ios": "bash scripts/release.sh ios --profile staging",
    "build:staging:android": "bash scripts/release.sh android --profile staging",
    "build:staging:play": "bash scripts/release.sh android --profile staging-play",
    "device": "eas device:create",
    "testflight": "bash scripts/release.sh ios --submit",
    "build:prod:ios": "bash scripts/release.sh ios",
    "build:prod:android": "bash scripts/release.sh android",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:staging:ios": "eas submit --platform ios --profile staging",
    "builds:ios": "eas build:list --platform ios --limit 5",
    "builds:android": "eas build:list --platform android --limit 5",
    "test": "vitest run"
  },
  "private": true
}
