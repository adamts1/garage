{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },

  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "APP_VARIANT": "staging" }
    },

    "simulator": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "APP_VARIANT": "staging" },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },

    "staging": {
      "environment": "preview",
      "env": { "APP_VARIANT": "staging" },
      "autoIncrement": true,
      "ios": { "distribution": "store" },
      "android": { "distribution": "internal", "buildType": "apk" }
    },

    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": { "APP_VARIANT": "production" },
      "android": { "buildType": "app-bundle" }
    }
  },

  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6790709441"
      }
    },
    "staging": {
      "ios": {
        "ascAppId": "6797201110"
      }
    }
  }
}
