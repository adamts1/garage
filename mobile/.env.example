# Local development only — copy to .env and fill in the STAGING project.
#
# This file is never read by an EAS build. Those get their URL and key from EAS
# environment variables (`eas env:list --environment preview|production`), which
# is what keeps the store builds on production and everything else on staging.
# Putting production values here would only affect `expo start` on this machine —
# and would be a staging-labelled app writing to real garages. Don't.
#
# Supabase → Project Settings → Data API / API Keys → publishable key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR-KEY
