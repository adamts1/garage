# Production credentials for `npm run onboard:prod`.
#
# Copy this file to .env.production.local and fill in the real values. That
# filename is matched by `.env.*.local` in .gitignore, so it cannot be
# committed — this .example is the only version that belongs in git.
#
# Deliberately NOT prefixed VITE_: these values must never reach a browser
# bundle or the APK. Only the anon key carries a VITE_ prefix, in .env.local.
#
# Values already in the environment win over this file, so a one-off
# `SUPABASE_URL=... npm run onboard` still overrides it.

# Supabase → garage-production → Project Settings → Data API
SUPABASE_URL=https://fdztfosbohiwskzfvwaj.supabase.co

# Supabase → garage-production → Project Settings → API Keys → service_role.
# This key bypasses RLS. onboard-garage.mjs refuses to run if it is not a
# service_role key, or if it names a different project than SUPABASE_URL —
# which is the check that catches a production URL paired with a staging key.
SUPABASE_SERVICE_ROLE_KEY=YOUR-PRODUCTION-SERVICE-ROLE-KEY
