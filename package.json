{
  "name": "garage-system-management",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:new": "supabase migration new",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:lint": "supabase db lint",
    "functions:status": "node scripts/functions-status.mjs",
    "mobile:status": "node scripts/mobile-status.mjs",
    "functions:push": "supabase functions deploy --project-ref poksqsdklnhaumozriqd",
    "functions:push:prod": "supabase functions deploy --project-ref farpgkljbmlaeiocrore",
    "test": "vitest run",
    "onboard": "node --env-file=.env.local scripts/onboard-garage.mjs",
    "onboard:prod": "node --env-file=.env.production.local scripts/onboard-garage.mjs",
    "dupes": "node --env-file=.env.local scripts/duplicate-customers.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "seed:garage": "node --env-file=.env.local scripts/seed-garage-demo.mjs",
    "seed:garage:prod": "node --env-file=.env.production.local scripts/seed-garage-demo.mjs",
    "connect-billing": "node --env-file=.env.local scripts/connect-billing.mjs",
    "connect-billing:prod": "node --env-file=.env.production.local scripts/connect-billing.mjs"
  },
  "dependencies": {
    "@garage/shared": "*",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/react": "^10.67.0",
    "@supabase/supabase-js": "^2.110.3",
    "i18next": "^26.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "supabase": "^2.109.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "packages/*"
  ]
}
